version: 1.0.6
date-released: 2026-08-17
preferred-citation:
  type: article
  title: "Do Agents Need an LLM to Remember? An Evaluation of LLM-Free Memory Ingestion"
  authors:
    - family-names: Baer
      given-names: Kristian
      affiliation: "Northtek Labs (FrostByte Digital LLC)"
  year: 2026
  doi: 10.5281/zenodo.21987934
